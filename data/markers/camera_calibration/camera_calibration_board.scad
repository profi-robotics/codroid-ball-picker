module black_square_tiles(tile_height_mm, z_offset_mm) {
  for (square = black_squares) {
    translate([square[0] + tile_offset_x_mm, square[1] + tile_offset_y_mm, z_offset_mm])
      cube([square_length_mm, square_length_mm, tile_height_mm]);
  }
}

module marker_black_tiles(tile_height_mm, z_offset_mm) {
  for (tile = marker_tiles) {
    translate([tile[0] + tile_offset_x_mm, tile[1] + tile_offset_y_mm, z_offset_mm])
      cube([cell_size_mm, cell_size_mm, tile_height_mm]);
  }
}

module rounded_plate() {
  hull() {
    translate([corner_radius_mm, corner_radius_mm, 0])
      cylinder(h = plate_thickness_mm, r = corner_radius_mm, $fn = 48);
    translate([plate_width_mm - corner_radius_mm, corner_radius_mm, 0])
      cylinder(h = plate_thickness_mm, r = corner_radius_mm, $fn = 48);
    translate([corner_radius_mm, plate_height_mm - corner_radius_mm, 0])
      cylinder(h = plate_thickness_mm, r = corner_radius_mm, $fn = 48);
    translate([plate_width_mm - corner_radius_mm, plate_height_mm - corner_radius_mm, 0])
      cylinder(h = plate_thickness_mm, r = corner_radius_mm, $fn = 48);
  }
}

module footer_engrave() {
  translate([plate_width_mm / 2, plate_margin_bottom_mm / 2, plate_thickness_mm - footer_text_depth_mm])
    linear_extrude(height = footer_text_depth_mm + 0.1)
      text(
        text = footer_text,
        size = footer_text_size_mm,
        font = "Liberation Sans:style=Bold",
        halign = "center",
        valign = "center"
      );
}

module base_plate() {
  difference() {
    rounded_plate();
    if (marker_inlay_mm > 0) {
      black_square_tiles(marker_inlay_mm + 0.1, plate_thickness_mm - marker_inlay_mm);
      marker_black_tiles(marker_inlay_mm + 0.1, plate_thickness_mm - marker_inlay_mm);
    }
    footer_engrave();
  }
}

module inlay_tiles() {
  if (marker_inlay_mm > 0) {
    black_square_tiles(marker_inlay_mm, plate_thickness_mm - marker_inlay_mm);
    marker_black_tiles(marker_inlay_mm, plate_thickness_mm - marker_inlay_mm);
  }
}

if (export_part == "base") {
  color(base_color) base_plate();
} else if (export_part == "inlay") {
  color(inlay_color) inlay_tiles();
} else {
  color(base_color) base_plate();
  color(inlay_color) inlay_tiles();
}